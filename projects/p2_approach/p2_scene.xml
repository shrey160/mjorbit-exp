<!--
  Project 2: approach a co-orbiting satellite.

  chaser: the Project 1 spacecraft (10 kg, 0.5 x 0.3 x 0.2 m) with three ideal
          thrusters on its free joint's translational DOFs. Free-joint linear DOFs
          are world-frame, so these are world-frame forces. That models a chaser
          whose attitude is held inertially fixed by its reaction wheels (the
          Project 1 result), so body-fixed thrusters act along fixed world axes.
  target: an inert 100 kg, 1 m cube, uncontrolled, starting at the chief.

  World = chief-centered local inertial frame, axes parallel to ECI (m, SI).
  Differential gravity comes from the orbit layer; MuJoCo gravity is zero.
  Contact is disabled: entering the keep-out sphere ends an episode instead.
  timestep 1.0 s: 1.2 cm drift error over 600 s vs 0.01 s, baseline unchanged (SPEC_2 3).
-->
<mujoco model="p2_approach">
  <compiler angle="radian"/>
  <option timestep="1.0" gravity="0 0 0" integrator="implicitfast">
    <flag contact="disable"/>
  </option>
  <mjorbit use_j2="false" use_drag="false" use_srp="false" use_magnetic="false"
           use_gravity_gradient="false"/>

  <worldbody>
    <light pos="0 0 10" dir="0 0 -1"/>
    <body name="chaser" pos="0 -20 0">
      <freejoint name="chaser_joint"/>
      <geom name="chaser_box" type="box" size="0.25 0.15 0.1" mass="10" rgba="0.85 0.7 0.2 1"/>
    </body>
    <body name="target" pos="0 0 0">
      <freejoint name="target_joint"/>
      <geom name="target_box" type="box" size="0.5 0.5 0.5" mass="100" rgba="0.6 0.65 0.75 1"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="thrust_x" joint="chaser_joint" gear="1 0 0 0 0 0" ctrlrange="-0.05 0.05"/>
    <motor name="thrust_y" joint="chaser_joint" gear="0 1 0 0 0 0" ctrlrange="-0.05 0.05"/>
    <motor name="thrust_z" joint="chaser_joint" gear="0 0 1 0 0 0" ctrlrange="-0.05 0.05"/>
  </actuator>
</mujoco>
